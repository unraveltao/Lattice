{
  "name": "lattice",
  "private": true,
  "version": "0.4.0",
  "description": "棂 / Lattice —— 可扩展的 Windows 桌面小组件平台",
  "type": "module",
  "scripts": {
    "widgets:index": "node scripts/widget-index.mjs",
    "create:widget": "node scripts/create-widget.mjs",
    "pack:widget": "node scripts/pack-widget.mjs",
    "sdk:sync": "node scripts/sdk-sync.mjs",
    "store:index": "node scripts/store-index.mjs",
    "sign:widget": "node scripts/sign-widget.mjs",
    "publish:widget": "node scripts/publish-widget.mjs",
    "winget:manifest": "node scripts/winget-manifest.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "dev": "npm run widgets:index && npm run store:index && vite",
    "build": "npm run widgets:index && npm run store:index && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:injection": "node --test scripts/widget-diagnostics.test.mjs",
    "test:sdk": "node --test scripts/sdk.test.mjs",
    "test:agent": "node --test scripts/lattice-agent.test.mjs",
    "test:tokens": "node --test scripts/check-tokens.test.mjs",
    "test:llm-proxy": "node --test scripts/dev-llm-proxy.test.mjs",
    "test:winget": "node --test scripts/winget-manifest.test.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "docs:query": "node scripts/docs-query.mjs",
    "check:stats": "node scripts/guards/stats.mjs",
    "check:version": "node scripts/guards/version.mjs",
    "stats": "node scripts/stats.mjs",
    "check:bridge": "node scripts/guards/bridge.mjs",
    "check:commands": "node scripts/guards/commands.mjs",
    "check:csp": "node scripts/guards/csp.mjs",
    "check:policy-tests": "node scripts/guards/policy-tests.mjs",
    "check:gates": "node scripts/guards/gates.mjs",
    "check:guards": "node scripts/guards/bridge.mjs && node scripts/guards/commands.mjs && node scripts/guards/csp.mjs && node scripts/guards/policy-tests.mjs && node scripts/guards/stats.mjs && node scripts/guards/version.mjs && node scripts/guards/gates.mjs",
    "agent": "node scripts/lattice-agent.mjs",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri.mjs dev",
    "tauri:build": "node scripts/tauri.mjs build",
    "test:browser": "node scripts/test-browser.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
